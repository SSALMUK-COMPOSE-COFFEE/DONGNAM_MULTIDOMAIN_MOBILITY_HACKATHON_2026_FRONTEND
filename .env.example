# 백엔드(FastAPI) 주소. 로컬 백엔드를 쓰면 http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=https://freshswitch.ssalhub.xyz

# enabled 면 MSW 목업으로 동작 (백엔드가 죽었을 때 시연 백업용)
NEXT_PUBLIC_API_MOCKING=disabled

# 카카오 디벨로퍼스 > 앱 > 플랫폼 키 > JavaScript 키
# 플랫폼 > Web 사이트 도메인에 http://localhost:3000 과 배포 도메인 등록 필요
NEXT_PUBLIC_KAKAO_MAP_KEY=
