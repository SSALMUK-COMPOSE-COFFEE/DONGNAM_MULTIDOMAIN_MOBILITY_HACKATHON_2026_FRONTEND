    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-kakao-maps-sdk": "^1.2.2",
    "recharts": "^3.10.1",
